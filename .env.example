# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot API token for sending real-time order notifications.
# Configure via Settings -> Secrets or in the Admin Panel -> Telegram Bot section.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHANNEL_ID: Target Telegram channel ID for real-time order alerts.
TELEGRAM_CHANNEL_ID=-1004316865165

# ADMIN_PASSCODE: Optional server-side passcode to access the OLOV MOBILE Admin Panel.
# If left unset, an inline first-run admin password setup form is provided on the server.
ADMIN_PASSCODE=
